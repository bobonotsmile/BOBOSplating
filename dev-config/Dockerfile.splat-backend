ARG SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:6.0
ARG DOTNET_IMAGE=mcr.microsoft.com/dotnet/aspnet:6.0
ARG UBUNTU_IMAGE=ubuntu:24.04
FROM ${SDK_IMAGE} AS build
WORKDIR /build
COPY splat-backend/ ./
RUN dotnet publish BoboSplat.Api.csproj -c Release -o /out --no-self-contained

FROM ${DOTNET_IMAGE} AS dotnet
FROM ${UBUNTU_IMAGE}
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl ffmpeg colmap libicu74 libssl3 libgomp1 \
    libvulkan1 vulkan-tools libegl1 libxkbcommon0 xz-utils \
    && rm -rf /var/lib/apt/lists/*
COPY --from=dotnet /usr/share/dotnet /usr/share/dotnet
ENV DOTNET_ROOT=/usr/share/dotnet PATH=/usr/share/dotnet:/opt/brush:$PATH \
    DOTNET_EnableDiagnostics=0 QT_QPA_PLATFORM=offscreen NO_COLOR=1 \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics XDG_RUNTIME_DIR=/tmp/bobo-runtime
RUN --mount=type=bind,source=dev-config/assets/brush-app-x86_64-unknown-linux-gnu.tar.xz,target=/tmp/brush.tar.xz,readonly \
    echo '4f0f9a8785d1951c62df26aae247c02c5bba32b00f40b06df4e1c9b867399e20  /tmp/brush.tar.xz' | sha256sum -c - \
    && mkdir -p /opt/brush && tar -xJf /tmp/brush.tar.xz --strip-components=1 -C /opt/brush \
    && chmod 755 /opt/brush/brush_app \
    && /opt/brush/brush_app --help >/dev/null \
    && colmap -h 2>&1 | grep -F 'COLMAP 3.9.1' \
    && dotnet --list-runtimes
WORKDIR /app
COPY --from=build /out/ ./
COPY dev-config/backend-entrypoint.sh /usr/local/bin/bobo-entrypoint
RUN chmod 755 /usr/local/bin/bobo-entrypoint
USER 1000:1000
ENTRYPOINT ["/usr/local/bin/bobo-entrypoint"]
CMD ["dotnet", "BoboSplat.Api.dll"]
