# Templates only. The application reads process environment variables.
# The Vite development server reads this file after it is copied to .env.
BOBO_BACKEND_URL=http://127.0.0.1:9131
BOBO_DEV_PORT=9130
# .NET: set these in the launching process. No implicit .env loading.
ASPNETCORE_URLS=http://127.0.0.1:9131
Bobo__DataRoot=./data
Bobo__MaxUploadBytes=1073741824
Bobo__MaxPendingJobs=20
Bobo__ProcessTimeoutMinutes=120
Bobo__MinRegistrationRatio=0.8
Bobo__Tools__Ffmpeg=ffmpeg
Bobo__Tools__Ffprobe=ffprobe
Bobo__Tools__Colmap=colmap
Bobo__Tools__Brush=brush_app

# Docker development / Ubuntu release values. Frontend is built before image build.
COMPOSE_PROJECT_NAME=bobosplating
BOBO_BACKEND_IMAGE=bobosplating-backend:0.1.0-ubuntu24
BOBO_FRONTEND_IMAGE=bobosplating-web:0.1.0
SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:6.0
DOTNET_IMAGE=mcr.microsoft.com/dotnet/aspnet:6.0
UBUNTU_IMAGE=ubuntu:24.04
NGINX_IMAGE=nginx:1.27-alpine
BOBO_BIND_IP=0.0.0.0
BOBO_HTTPS_PORT=9134
BOBO_API_PORT=9131
# Set to the IP address or DNS name actually used by browser clients; no scheme or port.
BOBO_PUBLIC_HOST=CHANGE_ME
BOBO_UID=1000
BOBO_GID=1000
BOBO_GPU_ID=0
BOBO_MAX_UPLOAD_BYTES=1073741824
# File limit + 1 MiB multipart allowance, must match backend request limit.
BOBO_REQUEST_MAX_BYTES=1074790400
BOBO_MAX_PENDING_JOBS=20
BOBO_PROCESS_TIMEOUT_MINUTES=120
BOBO_MIN_REGISTRATION_RATIO=0.8
